rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /img/{file} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email in ['josephabouatme@gmail.com'] && request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
  }
}
